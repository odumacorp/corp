    "shared_post": null,
    "shared_project": null,
    "timestamp": "2026-04-09T21:13:29.304Z",
    "is_read": true,
    "is_flagged": false,
    "flag_reason": null,
    "flagged_by": null,
    "is_hidden": false,
    "conversation": 21
  }
},
{
  "model": "core.message",
  "pk": 23,
  "fields": {
    "sender": 8,
    "recipient": 12,
    "reply_to": null,
    "content": "Hi Aunty, welcome to Oduma Corp! 👋\n\nHere are your login details — keep them safe:\n\n📧 Email: austinoduma9@mail.com\n👤 Username: aunty.maria\n\nYou can log in using either your email or username.\n\nHere's how to get started:\n1️⃣ Complete your profile — add a photo, bio, and your industry.\n2️⃣ Post your first project (innovators) or browse opportunities (investors).\n3️⃣ Connect with people in your industry and start collaborating.\n\nIf you have any questions, just reply here. We're happy to help! 🚀",
    "message_type": "text",
    "shared_post": null,
    "shared_project": null,
    "timestamp": "2026-04-09T21:13:29.353Z",
    "is_read": true,
    "is_flagged": false,
    "flag_reason": null,
